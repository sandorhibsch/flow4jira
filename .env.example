# Persistence mode: use "local" for a public/browser-only deployment, or "server"
# when the application is backed by PostgreSQL.
NEXT_PUBLIC_PERSISTENCE_MODE=local

# Required only when NEXT_PUBLIC_PERSISTENCE_MODE=server.
# Docker Compose default: postgresql://postgres:postgres@postgres:5432/flow4jira_dev
# For a local Node.js process, use localhost as the host and the published Postgres port.
DATABASE_URL=

# Jira connection, required when persistence mode is "server".
# Set to "server" for Jira Server/Data Center or "cloud" for Jira Cloud.
JIRA_INSTANCE_TYPE=server
JIRA_BASE_URL=https://jira.example.com

# Jira Server/Data Center: create a personal access token and set it here.
JIRA_PERSONAL_ACCESS_TOKEN=

# Jira Cloud: set both of these instead of JIRA_PERSONAL_ACCESS_TOKEN.
JIRA_EMAIL=
JIRA_API_TOKEN=
